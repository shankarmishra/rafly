# Lead data — never commit customer PII
private/
*.csv

# Local environment
.env
.env.local

# Database credentials. config.php loads this if present and falls back to
# safe defaults if not, so a fresh clone still runs — it just cannot reach a
# database until someone creates this file.
inc/config.local.php

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Generated
css/.cache/

# Uploaded media. Content, not code — it belongs in a backup, not in git, and
# committing it means every clone carries every image ever uploaded.
# The .htaccess that makes this directory non-executable IS tracked.
uploads/*
!uploads/.htaccess
# The preview seed's sample images (inc/data/seed-preview.php) are generated by
# inc/tools/build-paper.php and tracked so a fresh clone can preview.
!uploads/seed-*.png

# Local MySQL test config, kept for re-running the port verification.
inc/config.local.php.mysql-test
